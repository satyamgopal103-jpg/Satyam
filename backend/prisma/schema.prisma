datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CITIZEN
  VOLUNTEER
  WARD_OFFICER
  REPRESENTATIVE
  ADMIN
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ComplaintCategory {
  ROADS
  WATER
  WASTE
  DRAINAGE
  LIGHTING
  INFRASTRUCTURE
  FACILITIES
  OTHER
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String
  fullName        String
  phone           String?
  role            Role           @default(CITIZEN)
  ward            String         @default("Ward 4")
  constituency    String         @default("Metro North")
  points          Int            @default(100)
  isVerified      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  profile         UserProfile?
  complaints      Complaint[]    @relation("UserComplaints")
  comments        Comment[]
  pollVotes       PollVote[]
  memberships     CommunityMembership[]
  messagesSent    Message[]      @relation("SentMessages")
  notifications   Notification[]
  auditLogs       AuditLog[]
}

model UserProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?
  avatarUrl      String?
  volunteerHours Int       @default(0)
  isPublic       Boolean   @default(true)
}

model Department {
  id          String      @id @default(uuid())
  name        String      @unique
  contactEmail String
  helpline    String
  complaints  Complaint[]
}

model Complaint {
  id               String            @id @default(uuid())
  trackingId       String            @unique
  title            String
  description      String
  category         ComplaintCategory
  location         String
  latitude         Float?
  longitude        Float?
  status           ComplaintStatus   @default(SUBMITTED)
  departmentId     String?
  department       Department?       @relation(fields: [departmentId], references: [id])
  userId           String
  user             User              @relation("UserComplaints", fields: [userId], references: [id])
  officialResponse String?
  upvotes          Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  updates          ComplaintUpdate[]
  comments         Comment[]
}

model ComplaintUpdate {
  id          String          @id @default(uuid())
  complaintId String
  complaint   Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  status      ComplaintStatus
  note        String
  updatedBy   String
  createdAt   DateTime        @default(now())
}

model Representative {
  id                 String       @id @default(uuid())
  name               String
  title              String
  constituency       String
  party              String
  responseRatePercent Int         @default(90)
  projectsCompleted  Int          @default(10)
  activeComplaints   Int          @default(50)
  grantUtilized      String
  verified           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  projects           Project[]
}

model Project {
  id                  String          @id @default(uuid())
  title               String
  description         String
  category            String
  location            String
  budget              String
  progressPercent     Int             @default(0)
  startDate           DateTime
  estimatedCompletion DateTime
  representativeId    String?
  representative      Representative? @relation(fields: [representativeId], references: [id])
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  updates             ProjectUpdate[]
}

model ProjectUpdate {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String
  createdAt   DateTime  @default(now())
}

model Community {
  id          String                @id @default(uuid())
  name        String
  description String
  ward        String
  createdAt   DateTime              @default(now())
  memberships CommunityMembership[]
  posts       Post[]
}

model CommunityMembership {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@unique([communityId, userId])
}

model Post {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  content     String
  authorName  String
  createdAt   DateTime  @default(now())
}

model Comment {
  id          String     @id @default(uuid())
  complaintId String
  complaint   Complaint  @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  text        String
  isOfficial  Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

model Message {
  id          String    @id @default(uuid())
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String?
  channelName String?
  content     String
  createdAt   DateTime  @default(now())
}

model Poll {
  id                      String       @id @default(uuid())
  question                String
  description             String
  isOfficialConsultation Boolean      @default(false)
  closesAt                DateTime
  createdAt               DateTime     @default(now())
  options                 PollOption[]
}

model PollOption {
  id        String     @id @default(uuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text      String
  votes     Int        @default(0)
  pollVotes PollVote[]
}

model PollVote {
  id       String     @id @default(uuid())
  pollId   String
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id])
  votedAt  DateTime   @default(now())

  @@unique([pollId, userId])
}

model VolunteerOpportunity {
  id                 String   @id @default(uuid())
  title              String
  organizer          String
  eventDate          DateTime
  location           String
  requiredVolunteers Int
  pointsAwarded      Int      @default(30)
  createdAt          DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  category  String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp DateTime @default(now())
}
